{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "kdg/course.json",
 "type": "object",
 "title": "Course",
 "required": [
  "course_code",
  "title",
  "family",
  "source_pdf",
  "syllabus_hash",
  "parse_confidence",
  "modules",
  "status"
 ],
 "properties": {
  "course_code": {
   "type": "string"
  },
  "title": {
   "type": "string"
  },
  "family": {
   "type": "string",
   "description": "family id from docs/formats"
  },
  "source_pdf": {
   "type": "string"
  },
  "syllabus_hash": {
   "type": "string",
   "description": "sha256 of the course page text"
  },
  "parse_confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "status": {
   "enum": [
    "accepted",
    "rejected"
   ]
  },
  "rejection_reason": {
   "type": [
    "string",
    "null"
   ]
  },
  "modules": {
   "type": "array",
   "items": {
    "$ref": "module.json"
   }
  }
 },
 "additionalProperties": false
}