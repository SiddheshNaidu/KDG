{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "kdg/topic.json",
 "type": "object",
 "title": "Topic",
 "required": [
  "topic_key",
  "course_code",
  "module_no",
  "name",
  "source_page",
  "source_quote",
  "parse_confidence"
 ],
 "properties": {
  "topic_key": {
   "type": "string",
   "pattern": "^[A-Za-z0-9]+:[0-9]+:[a-z0-9-]+$",
   "description": "<course_code>:<module_no>:<slug>"
  },
  "course_code": {
   "type": "string"
  },
  "module_no": {
   "type": "integer",
   "minimum": 1
  },
  "name": {
   "type": "string",
   "minLength": 1,
   "maxLength": 80
  },
  "source_page": {
   "type": "integer",
   "minimum": 1
  },
  "source_quote": {
   "type": "string",
   "maxLength": 400,
   "description": "verbatim line(s) the Topic was derived from"
  },
  "parse_confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "validity_violations": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^R[1-8]_"
   }
  }
 },
 "additionalProperties": false
}